---
import WorkSection from '@/components/sections/WorkSection.astro';
import type { ProjectCategory } from '@/config/site';
import type { Lang } from '@/i18n/ui';
import { getTranslations } from '@/i18n/utils';
import BaseLayout from '@/layouts/BaseLayout.astro';

interface Props {
  lang: Lang;
  /** Categoría preseleccionada. Sin categoría se muestran todos los proyectos. */
  category?: ProjectCategory;
}

const { lang, category } = Astro.props;
const t = getTranslations(lang);

const pageTitle = category
  ? `${t('work.title')}: ${t(`category.${category}`)}`
  : t('work.title');
---

<BaseLayout lang={lang} title={pageTitle}>
  <WorkSection lang={lang} category={category} titleLevel="h1" />
</BaseLayout>
