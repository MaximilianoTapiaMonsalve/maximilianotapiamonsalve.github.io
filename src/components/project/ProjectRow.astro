---
import { getProjectUrl, type Project } from '@/lib/projects';
import { Image } from 'astro:assets';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, description, year, stack, cover } = project.data;
const url = getProjectUrl(project);
---

<li class:list={['row', { linked: url }]}>
  <span class="year">{year}</span>
  <div class="main">
    <h3 class="title">
      {url ? (
        <a class="link" href={url}>
          {title}
        </a>
      ) : (
        title
      )}
    </h3>
    <p class="description">{description}</p>
  </div>
  {stack.length > 0 && <p class="stack">{stack.join(' · ')}</p>}
  {url && (
    <span class="arrow" aria-hidden="true">
      ↗
    </span>
  )}
  {url && cover && (
    <div class="preview" aria-hidden="true">
      <Image src={cover} alt="" width={660} />
    </div>
  )}
</li>

<style lang="less">
  @import (reference) '@/styles/mixins.less';

  .row {
    position: relative;
    display: grid;
    grid-template-areas:
      'year stack'
      'main main';
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-2) var(--space-4);
    align-items: baseline;
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-line);
    transition:
      background-color var(--duration) ease,
      box-shadow var(--duration) ease;

    @media @mq-md {
      grid-template-areas: 'year main stack arrow';
      grid-template-columns: 4.875rem minmax(0, 1fr) 12.5rem 1.625rem;
      gap: var(--space-6);
    }
  }

  .year {
    .type-meta();
    grid-area: year;
    font-size: var(--text-label);
    transition:
      color var(--duration) ease,
      transform var(--duration) var(--ease-out);
  }

  .main {
    grid-area: main;
  }

  .title {
    .type-project();
    transition: color var(--duration) ease;
  }

  .link {
    color: inherit;
    text-decoration: none;

    // Toda la fila es clicable a través del enlace del título.
    &::after {
      position: absolute;
      inset: 0;
      content: '';
    }

    &:focus-visible {
      outline: none;
    }
  }

  .description {
    .type-body();
    max-width: 54ch;
    margin-top: 0.375rem;
  }

  .stack {
    .type-meta();
    grid-area: stack;
    font-size: 0.75rem;
    color: var(--color-text-3);
  }

  .arrow {
    display: none;
    grid-area: arrow;
    font-size: 1.1875rem;
    line-height: 1;
    color: var(--color-decor);
    transition: color var(--duration) ease;

    @media @mq-md {
      display: block;
    }
  }

  // Hover y foco: lavado de acento, barra interior y título en acento.
  .linked:hover,
  .linked:has(.link:focus-visible) {
    background-color: var(--color-accent-wash);
    box-shadow: inset 2px 0 0 var(--color-accent);

    .title,
    .year,
    .arrow {
      color: var(--color-accent);
    }

    @media @mq-md {
      .year {
        transform: translateX(var(--space-4));
      }
    }
  }

  .linked:has(.link:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  // Vista previa flotante: solo en dispositivos con ratón y sin JavaScript.
  .preview {
    display: none;
  }

  @media @hover-fine {
    .preview {
      position: absolute;
      right: -0.875rem;
      bottom: calc(100% - var(--space-4));
      z-index: 2;
      display: block;
      width: 20.625rem;
      padding: 0.5625rem;
      pointer-events: none;
      background-color: var(--color-surface);
      border: 1px solid var(--color-line-strong);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-float);
      opacity: 0;
      transform: rotate(-1.4deg) translateY(0.5rem);
      transition:
        opacity var(--duration) var(--ease-out),
        transform var(--duration) var(--ease-out);

      :global(img) {
        width: 100%;
        aspect-ratio: 16 / 10;
        object-fit: cover;
        border-radius: var(--radius-xs);
      }
    }

    .linked:hover .preview,
    .linked:has(.link:focus-visible) .preview {
      opacity: 1;
      transform: rotate(-1.4deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .row,
    .year,
    .title,
    .arrow,
    .preview {
      transition: none;
    }

    .linked:hover .year,
    .linked:has(.link:focus-visible) .year {
      transform: none;
    }
  }
</style>
