---
import ContactForm from '@/components/ContactForm';
import InfoPanel, { type InfoItem } from '@/components/ui/InfoPanel.astro';
import { site } from '@/config/site';
import type { Lang } from '@/i18n/ui';
import { getTranslations } from '@/i18n/utils';

interface Props {
  lang: Lang;
  /** Nivel del título: h1 en la página propia, h2 dentro de la landing. */
  titleLevel?: 'h1' | 'h2';
}

const { lang, titleLevel = 'h2' } = Astro.props;
const Title = titleLevel;
const t = getTranslations(lang);

// Datos prácticos junto al formulario; solo se muestran los que están configurados.
const info: InfoItem[] = [];
if (site.email) {
  info.push({
    label: t('contact.direct'),
    links: [{ label: site.email, href: `mailto:${site.email}` }],
  });
}
if (site.location) {
  info.push({ label: t('contact.location'), value: site.location });
}
if (site.timezone) {
  info.push({ label: t('contact.timezone'), value: site.timezone });
}
if (site.socials.length > 0) {
  info.push({
    label: t('contact.elsewhere'),
    links: site.socials.map(({ label, url }) => ({ label, href: url })),
  });
}
---

<section
  id="contact"
  class="contact"
  data-section
  tabindex="-1"
  aria-labelledby="contact-title"
>
  <div class="main">
    <Title id="contact-title" class="title">
      {t('contact.title')}
    </Title>
    <p class="lead">{t('contact.intro')}</p>
    <ContactForm
      client:visible
      formId={site.formspreeFormId}
      labels={{
        name: t('contact.name'),
        email: t('contact.email'),
        message: t('contact.message'),
        submit: t('contact.submit'),
        sending: t('contact.sending'),
        success: t('contact.success'),
        error: t('contact.error'),
        helper: t('contact.helper'),
      }}
    />
  </div>
  {info.length > 0 && <InfoPanel items={info} />}
</section>

<style lang="less">
  @import (reference) '@/styles/mixins.less';

  .contact {
    .container();
    display: grid;
    gap: var(--space-9);
    padding-top: var(--space-10);

    @media @mq-lg {
      grid-template-columns: minmax(0, 1fr) 15.625rem;
      align-items: start;
    }

    &:focus {
      outline: none;
    }
  }

  .title {
    .type-title();
  }

  .lead {
    .type-lead();
    margin-block: var(--space-4) var(--space-7);
    color: var(--color-text);
  }
</style>
