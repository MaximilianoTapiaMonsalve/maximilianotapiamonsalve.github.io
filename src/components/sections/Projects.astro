---
import type { Lang } from '@/i18n/ui';
import { getTranslations } from '@/i18n/utils';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getTranslations(lang);

// Cada proyecto existe una vez por idioma: src/content/projects/<lang>/<id>.md
const projects = (
  await getCollection('projects', ({ id }) => id.startsWith(`${lang}/`))
).sort((a, b) => a.data.order - b.data.order);
---

<section id="projects" class="projects" aria-labelledby="projects-title">
  <h2 id="projects-title">{t('projects.title')}</h2>
  {projects.length === 0 ? (
    <p>{t('projects.empty')}</p>
  ) : (
    <ul class="grid">
      {projects.map(({ data }) => (
        <li class="card">
          {data.cover && (
            <Image src={data.cover} alt={data.coverAlt ?? ''} width={1200} />
          )}
          <div class="body">
            <h3>{data.title}</h3>
            <p>{data.description}</p>
            {data.tags.length > 0 && (
              <ul class="tags">
                {data.tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
            )}
            {(data.repo || data.demo) && (
              <p class="links">
                {data.repo && <a href={data.repo}>{t('projects.repo')}</a>}
                {data.demo && <a href={data.demo}>{t('projects.demo')}</a>}
              </p>
            )}
          </div>
        </li>
      ))}
    </ul>
  )}
</section>

<style lang="less">
  @import (reference) '@/styles/mixins.less';

  .projects {
    .section();
  }

  .grid {
    display: grid;
    gap: var(--space-lg);
    margin: 0;
    padding: 0;
    list-style: none;

    @media @mq-md {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .card {
    overflow: hidden;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);

    :global(img) {
      width: 100%;
      aspect-ratio: 1200 / 630;
      object-fit: cover;
    }
  }

  .body {
    padding: var(--space-md) var(--space-lg) var(--space-lg);

    h3 {
      margin: 0 0 var(--space-sm);
    }

    p {
      margin: 0 0 var(--space-md);
    }
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-sm);
    margin: 0 0 var(--space-md);
    padding: 0;
    list-style: none;

    li {
      padding: 0 var(--space-sm);
      font-size: 0.875rem;
      border: 1px solid var(--color-border);
      border-radius: 999px;
    }
  }

  .links {
    display: flex;
    gap: var(--space-md);
  }
</style>
