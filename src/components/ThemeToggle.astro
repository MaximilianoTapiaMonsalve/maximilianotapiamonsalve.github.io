---
import type { Lang } from '@/i18n/ui';
import { getTranslations } from '@/i18n/utils';

interface Props {
  lang: Lang;
}

const t = getTranslations(Astro.props.lang);
---

<button
  type="button"
  class="theme-toggle"
  aria-pressed="false"
  data-theme-toggle
>
  <span class="visually-hidden">{t('theme.dark')}</span>
  <svg
    class="moon"
    viewBox="0 0 24 24"
    width="20"
    height="20"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
  </svg>
  <svg
    class="sun"
    viewBox="0 0 24 24"
    width="20"
    height="20"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
</button>

<script>
  type Theme = 'light' | 'dark';

  const root = document.documentElement;
  const toggles = document.querySelectorAll<HTMLButtonElement>(
    '[data-theme-toggle]',
  );

  function getStoredTheme(): Theme | null {
    try {
      const value = localStorage.getItem('theme');
      return value === 'light' || value === 'dark' ? value : null;
    } catch {
      return null;
    }
  }

  function applyTheme(theme: Theme) {
    root.dataset.theme = theme;
    toggles.forEach((toggle) =>
      toggle.setAttribute('aria-pressed', String(theme === 'dark')),
    );
  }

  applyTheme(root.dataset.theme === 'dark' ? 'dark' : 'light');

  toggles.forEach((toggle) =>
    toggle.addEventListener('click', () => {
      const next: Theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
      applyTheme(next);
      try {
        localStorage.setItem('theme', next);
      } catch {
        // Sin almacenamiento, el tema elegido dura hasta recargar la página.
      }
    }),
  );

  // Sin preferencia guardada, sigue los cambios de tema del sistema.
  matchMedia('(prefers-color-scheme: dark)').addEventListener(
    'change',
    (event) => {
      if (!getStoredTheme()) applyTheme(event.matches ? 'dark' : 'light');
    },
  );
</script>

<style lang="less">
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    color: var(--color-text);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    cursor: pointer;
  }

  .sun {
    display: none;
  }

  :global([data-theme='dark']) {
    .moon {
      display: none;
    }

    .sun {
      display: block;
    }
  }
</style>
