---
import type { Lang } from '@/i18n/ui';
import { getTranslations } from '@/i18n/utils';

interface Props {
  lang: Lang;
}

const t = getTranslations(Astro.props.lang);
---

<button
  type="button"
  class="theme-toggle"
  aria-pressed="false"
  data-theme-toggle
>
  <span class="icon" aria-hidden="true"></span>
  {t('theme.label')}
</button>

<script>
  type Theme = 'light' | 'dark';

  const root = document.documentElement;
  const toggles = document.querySelectorAll<HTMLButtonElement>(
    '[data-theme-toggle]',
  );

  function getStoredTheme(): Theme | null {
    try {
      const value = localStorage.getItem('theme');
      return value === 'light' || value === 'dark' ? value : null;
    } catch {
      return null;
    }
  }

  function applyTheme(theme: Theme) {
    root.dataset.theme = theme;
    toggles.forEach((toggle) =>
      toggle.setAttribute('aria-pressed', String(theme === 'dark')),
    );
  }

  applyTheme(root.dataset.theme === 'dark' ? 'dark' : 'light');

  toggles.forEach((toggle) =>
    toggle.addEventListener('click', () => {
      const next: Theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
      applyTheme(next);
      try {
        localStorage.setItem('theme', next);
      } catch {
        // Sin almacenamiento, el tema elegido dura hasta recargar la página.
      }
    }),
  );

  // Sin preferencia guardada, sigue los cambios de tema del sistema.
  matchMedia('(prefers-color-scheme: dark)').addEventListener(
    'change',
    (event) => {
      if (!getStoredTheme()) applyTheme(event.matches ? 'dark' : 'light');
    },
  );
</script>

<style lang="less">
  .theme-toggle {
    display: inline-flex;
    gap: 0.375rem;
    align-items: center;
    padding: 0.3125rem 0.5625rem;
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    font-weight: 500;
    line-height: 1.2;
    color: var(--color-text-3);
    cursor: pointer;
    background: transparent;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-pill);
    transition:
      color var(--duration-fast) ease,
      border-color var(--duration-fast) ease;

    &:hover {
      color: var(--color-ink);
      border-color: var(--color-ink);
    }
  }

  .icon {
    width: 0.5625rem;
    height: 0.5625rem;
    background: linear-gradient(90deg, currentColor 50%, transparent 50%);
    border: 1.5px solid currentColor;
    border-radius: 50%;
  }

  [aria-pressed='true'] .icon {
    background: currentColor;
  }
</style>
