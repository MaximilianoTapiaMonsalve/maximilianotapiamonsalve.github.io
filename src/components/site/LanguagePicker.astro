---
import { languages, type Lang } from '@/i18n/ui';
import { getTranslations } from '@/i18n/utils';
import { getRelativeLocaleUrl } from 'astro:i18n';

interface Props {
  lang: Lang;
  /** Ruta actual sin prefijo de idioma, para enlazar a la misma página. */
  route: string;
}

const { lang, route } = Astro.props;
const t = getTranslations(lang);
---

<nav aria-label={t('lang.label')}>
  <ul class="languages">
    {(Object.keys(languages) as Lang[]).map((code) => (
      <li>
        <a
          href={getRelativeLocaleUrl(code, route)}
          hreflang={code}
          lang={code}
          aria-current={code === lang ? 'page' : undefined}
        >
          {code.toUpperCase()}
          <span class="visually-hidden">{` ${languages[code]}`}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style lang="less">
  .languages {
    display: flex;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    font-weight: 500;
    list-style: none;
  }

  a {
    padding-bottom: 2px;
    color: var(--color-text-3);
    text-decoration: none;

    &:hover {
      color: var(--color-ink);
    }

    &[aria-current] {
      color: var(--color-ink);
      box-shadow: 0 1px 0 var(--color-accent);
    }
  }
</style>
