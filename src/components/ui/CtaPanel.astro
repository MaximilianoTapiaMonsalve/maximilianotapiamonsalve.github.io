---
import Button from '@/components/ui/Button.astro';

interface Props {
  title: string;
  text: string;
  href: string;
  buttonLabel: string;
}

const { title, text, href, buttonLabel } = Astro.props;
---

<section class="cta" aria-labelledby="cta-title" data-reveal>
  <div>
    <h2 id="cta-title">{title}</h2>
    <p>{text}</p>
  </div>
  <Button href={href} variant="inverse">
    {buttonLabel}
  </Button>
</section>

<script>
  import { initScrollReveal } from '@/lib/scroll-reveal';

  initScrollReveal('[data-reveal]');
</script>

<style lang="less">
  @import (reference) '@/styles/mixins.less';

  .cta {
    display: grid;
    gap: var(--space-5);
    align-items: center;
    justify-items: start;
    padding: var(--space-6) var(--space-7);
    color: var(--cta-text);
    background-color: var(--cta-bg);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);

    @media @mq-md {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--space-7);
    }
  }

  h2 {
    font-size: 1.5rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: inherit;
  }

  p {
    margin-top: var(--space-2);
    font-size: var(--text-body);
    line-height: 1.6;
    color: var(--cta-text-muted);
  }
</style>
