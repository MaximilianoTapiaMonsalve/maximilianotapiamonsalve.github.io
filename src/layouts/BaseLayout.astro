---
import '@/styles/global.less';

import SiteFooter from '@/components/site/SiteFooter.astro';
import SiteHeader from '@/components/site/SiteHeader.astro';
import { site } from '@/config/site';
import { defaultLang, languages, type Lang } from '@/i18n/ui';
import { getRouteWithoutLocale, getTranslations } from '@/i18n/utils';
import { Font } from 'astro:assets';
import { getAbsoluteLocaleUrl } from 'astro:i18n';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Para páginas que no deben indexarse ni tener versiones alternativas (p. ej. 404). */
  noindex?: boolean;
}

const { lang, title, description, noindex = false } = Astro.props;
const t = getTranslations(lang);

const pageTitle = title
  ? `${title} · ${site.name}`
  : `${site.name} · ${t('site.title')}`;
const pageDescription = description ?? t('site.description');
const route = noindex ? '' : getRouteWithoutLocale(Astro.url.pathname);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="canonical" href={getAbsoluteLocaleUrl(lang, route)} />
        <meta property="og:url" content={getAbsoluteLocaleUrl(lang, route)} />
        {(Object.keys(languages) as Lang[]).map((code) => (
          <link
            rel="alternate"
            hreflang={code}
            href={getAbsoluteLocaleUrl(code, route)}
          />
        ))}
        <link
          rel="alternate"
          hreflang="x-default"
          href={getAbsoluteLocaleUrl(defaultLang, route)}
        />
        <link rel="sitemap" href="/sitemap-index.xml" />
      </>
    )}
    <script is:inline>
      // Aplica el tema antes del primer pintado para evitar el parpadeo.
      (() => {
        let theme = null;
        try {
          theme = localStorage.getItem('theme');
        } catch {
          // Almacenamiento no disponible: se usa la preferencia del sistema.
        }
        if (theme !== 'light' && theme !== 'dark') {
          theme = matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light';
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t('nav.skip')}
    </a>
    <SiteHeader lang={lang} route={route} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<style lang="less">
  body {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
  }

  main {
    flex: 1;
  }

  .skip-link {
    position: absolute;
    top: -100%;
    left: var(--gutter);
    z-index: 10;
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-ui);
    color: var(--color-on-ink);
    background-color: var(--color-ink);
    border-radius: var(--radius-sm);

    &:focus {
      top: var(--space-4);
    }
  }
</style>
